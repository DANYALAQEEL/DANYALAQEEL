                stdout to Merge.output;
            }
        }

    }
    Component Package : UnixFilterT = new UnixFilterT extended with {
        Port stdin : UnixFilterInputPortT = new UnixFilterInputPortT extended with {

        }
        Port output0 : FilterOutputPortT = new FilterOutputPortT extended with {

        }

        Property cmd = "tar";

