import families/PipeAndFilter.acme;
family UnixPipeAndFilter extends PipeAndFilterFam with {
   port type UnixFilterOutputPortT extends FilterOutputPortT with {
     rule noDangling = invariant attachedOrBound (self);
   };
   port type UnixFilterInputPortT extends FilterInputPortT with {
     rule noDangling = invariant attachedOrBound (self);
   };
   component type FileSystemSourceT extends SourceCompT with {
      property path : string;
   };
   component type UnixFilterT extends FilterCompT with {
      property cmd : string;
   };
   component type FileSystemSinkT extends SinkCompT with {
      property path : string;
   };
  } 